---
layout: layout
---
<section class="post-list">
  <% page.posts.each(function(post) { %>
    <article class="post-item">
      <h2 class="post-title"><a href="<%- url_for(post.path) %>"><%= post.title %></a></h2>
      <div class="post-meta">
        <time datetime="<%= post.date.format('YYYY-MM-DD') %>"><%= post.date.format('YYYY-MM-DD') %></time>
        <% if (post.tags && post.tags.length) { %>
          <span class="post-tags">
            <% post.tags.each(function(tag) { %>
              <a href="<%- url_for(tag.path) %>">#<%= tag.name %></a>
            <% }) %>
          </span>
        <% } %>
      </div>
      <div class="post-excerpt"><%- post.excerpt || post.content.substring(0, 200) %></div>
      <a class="read-more" href="<%- url_for(post.path) %>">阅读全文 →</a>
    </article>
  <% }) %>
</section>
<%- paginator({ prev_text: '← 上一页', next_text: '下一页 →' }) %>
