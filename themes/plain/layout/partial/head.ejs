<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= page.title ? page.title + ' | ' + theme.site_name : theme.site_name %></title>
<meta name="description" content="<%= page.description || config.description %>">
<meta name="theme-color" content="#faf9f7" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#2b3c55" media="(prefers-color-scheme: dark)">
<link rel="icon" type="image/svg+xml" href="<%- url_for('/favicon.svg') %>">
<link rel="alternate" type="application/atom+xml" title="<%= theme.site_name %>" href="<%- url_for('atom.xml') %>">
<link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
<link rel="stylesheet" href="<%- url_for('/css/main.css') %>">
